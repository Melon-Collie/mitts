class_name AIReboundField

# The rebound field (AIReboundFieldData, generated by
# tests/instruments/ai/test_generate_rebound_field.gd): what the live goalie's
# save does with a charged wrister from a spot, at a keeper set square on the
# carrier. Per spot, its measured shots, each with its outcome and, for a live
# rebound, the puck and the keeper every SAMPLE_S from the first contact. Read in
# the frame of the net being attacked. Built once, lazily. A leaf: reads no
# evaluator.

enum Outcome { GOAL, MISSED, COVERED, LIVE, REBOUND_GOAL }

const SAMPLE_S: float = AIReboundFieldData.SAMPLE_S

static var _built: bool = false
# Per spot (SPOT_FWD-major, SPOT_X-minor): its first row and row count.
static var _spot_first := PackedInt32Array()
static var _spot_count := PackedInt32Array()
# Per row.
static var _outcome := PackedByteArray()
static var _sample_first := PackedInt32Array()
static var _sample_count := PackedInt32Array()
# Per sample, in the data's frame: x across, metres out from the goal line, and
# the velocity's x and its component away from the goal line.
static var _x := PackedFloat32Array()
static var _out := PackedFloat32Array()
static var _vx := PackedFloat32Array()
static var _vout := PackedFloat32Array()
static var _keeper_down := PackedByteArray()


# The measured spot nearest `release`, attacking the net at `attacking_goal`.
static func spot_of(release: Vector3, attacking_goal: Vector3) -> int:
	_build()
	var out: float = _out_of(release, attacking_goal)
	var xi: int = _nearest(AIReboundFieldData.SPOT_X, release.x)
	var fi: int = _nearest(AIReboundFieldData.SPOT_FWD, out)
	return fi * AIReboundFieldData.SPOT_X.size() + xi


static func shot_count(spot: int) -> int:
	_build()
	return _spot_count[spot]


# The `k`-th measured shot from `spot`.
static func shot(spot: int, k: int) -> int:
	_build()
	return _spot_first[spot] + k


static func outcome(row: int) -> int:
	_build()
	return _outcome[row]


static func sample_count(row: int) -> int:
	_build()
	return _sample_count[row]


# The rebound's `k`-th sample (k × SAMPLE_S after the first contact) on the
# ice, in world coordinates of the net at `attacking_goal`.
static func sample_pos(row: int, k: int, attacking_goal: Vector3) -> Vector3:
	var i: int = _sample_first[row] + k
	return Vector3(_x[i], 0.0, attacking_goal.z - signf(attacking_goal.z) * _out[i])


static func sample_vel(row: int, k: int, attacking_goal: Vector3) -> Vector3:
	var i: int = _sample_first[row] + k
	return Vector3(_vx[i], 0.0, -signf(attacking_goal.z) * _vout[i])


static func keeper_down(row: int, k: int) -> bool:
	return _keeper_down[_sample_first[row] + k] == 1


static func _out_of(p: Vector3, attacking_goal: Vector3) -> float:
	return (attacking_goal.z - p.z) * signf(attacking_goal.z)


static func _nearest(grid: Array[float], v: float) -> int:
	var best: int = 0
	for i: int in grid.size():
		if absf(grid[i] - v) < absf(grid[best] - v):
			best = i
	return best


static func _build() -> void:
	if _built:
		return
	_built = true
	var nx: int = AIReboundFieldData.SPOT_X.size()
	var spots: int = nx * AIReboundFieldData.SPOT_FWD.size()
	_spot_first.resize(spots)
	_spot_count.resize(spots)
	_spot_first.fill(-1)
	_spot_count.fill(0)
	var codes: String = "GWCSR"
	var probe := GoalieNetworkState.new()
	for r: int in AIReboundFieldData.ROWS.size():
		var f: PackedStringArray = AIReboundFieldData.ROWS[r].split("\t")
		var spot: int = _nearest(AIReboundFieldData.SPOT_FWD, float(f[2])) * nx \
				+ _nearest(AIReboundFieldData.SPOT_X, float(f[1]))
		if _spot_first[spot] < 0:
			_spot_first[spot] = r
		_spot_count[spot] += 1
		_outcome.append(codes.find(f[5]))
		_sample_first.append(_x.size())
		var n: int = 0
		if f.size() > 7 and not f[7].is_empty():
			for s: String in f[7].split(";"):
				var v: PackedStringArray = s.split(",")
				_x.append(float(v[0]))
				_out.append(float(v[1]))
				_vx.append(float(v[3]))
				_vout.append(float(v[4]))
				probe.state_enum = int(v[7])
				_keeper_down.append(1 if probe.is_down() else 0)
				n += 1
		_sample_count.append(n)
