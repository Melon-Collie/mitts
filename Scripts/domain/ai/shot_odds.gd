class_name AIShotOdds
extends RefCounted

# The odds a shot beats today's goalie, read from the field measured off the live
# GoalieController (AIShotFieldData, generated by
# .claude/hooks/generate-shot-field.sh — docs/shot-currency-plan.md). Nothing
# here models the goalie: a goalie change is a regeneration, never an edit here.
#
# A cell is one measured situation: a release spot, the keeper's read, and his
# open set (FLAT / LOW / HIGH × aims post to post). Each aim's odds are its goal
# fraction under REFERENCE_SPREAD_RAD of placement scatter; the cell's odds are
# its best aim's. A query is bilinear over the release-spot grid; within a spot
# it is a kernel over the cells' keeper state, so the answer leans on the
# situations most like this one.
#
# Two kinds of situation:
#   shot now — the keeper as he stands: shooting off the carry, or what a carry
#     arrives at. Samples: settled, after a deke, as feeds left him on arrival,
#     and drawn out of position by a decoy carrier. His stance is matched exactly
#     (Stance): a keeper sealed on his post and one sprawled after a feed are
#     both "down", and nothing alike. A sealed one is matched on whether the
#     release is inside his seal zone too (AIGoalieModel.in_post_seal_zone):
#     outside it the puck has been pulled off the line and he is leaving the
#     post, which is a different keeper from one set on it.
#   feed     — a pass, read at the passer's decision with the keeper square on the
#     passer; what he manages over the flight is the goalie's own answer.
#
# The value queries average the cells' best odds; the pick blends the cells'
# per-aim odds and takes the best aim, so it costs more and runs once a shot is
# committed. Where neighbouring cells disagree on the aim, the average of their
# bests reads a little above the best of the blend.
#
# Where the application layer installs `native_factory` (the extension is built),
# the weighing runs in NativeShotOdds, held to this file by
# test_native_shot_odds_parity.gd; the matched cells come back only to a query
# that reads them (_sync_cells).
#
# A query's scratch is a Query. Every read takes one, the AI worker's when none
# is passed; a caller on another thread passes its own (the xG stat, on the main
# thread at a release), or the two overwrite each other mid-read. The field
# itself is read-only once built (prepare).

# Placement scatter (radians) the odds are priced at — about the Normal hand. A
# decision is made before the release and the keeper's timing at release varies,
# so a window narrower than this is not odds to bank on.
const REFERENCE_SPREAD_RAD: float = 0.04

# Kernel widths over the keeper state. Sized to the spacing the generator
# samples at, so a query between two samples reads both.
const OFFSET_BANDWIDTH_M: float = 0.3
const VELOCITY_BANDWIDTH_M_S: float = 1.0
# Depth is his distance from the goal centre; squareness the signed angle from
# his facing to the release. Together they tell a keeper set on the shot from
# one a pass or a decoy dragged off it at the same lateral offset.
const DEPTH_BANDWIDTH_M: float = 0.3
const SQUARE_BANDWIDTH_RAD: float = 0.25
const TRAVEL_BANDWIDTH_M: float = 0.3
const FLIGHT_BANDWIDTH_S: float = 0.1
# Below this total kernel weight a spot falls back to its nearest sample.
const _MIN_WEIGHT: float = 1e-4
# How the keeper stands, matched exactly within a spot.
enum Stance { UPRIGHT, DOWN, POST_SEAL }

# The field's lofts, in the order its outcome strings are stored.
const LOFTS: Array[int] = [ShotMechanics.ELEVATION_FLAT, ShotMechanics.ELEVATION_LOW,
		ShotMechanics.ELEVATION_HIGH]

# The net the field was measured at; every query is mapped into its frame.
const _FIELD_GOAL := Vector3(0.0, 0.0, -GameRules.GOAL_LINE_Z)


# A shot the field recommends: the odds, where to aim on the goal line (world),
# and the loft level.
class Pick:
	var odds: float = 0.0
	var aim := Vector3.INF
	var loft: int = ShotMechanics.ELEVATION_FLAT


# One query's scratch: each matching cell's share of the answer, the odds they
# give, and the kernel that ran it (whose own copy of the cells `cells` lags until
# _sync_cells). `use_native` false holds the query to the GDScript reference.
class Query:
	var cells := PackedInt32Array()
	var weights := PackedFloat32Array()
	var blend := PackedFloat32Array()
	var count: int = 0
	var odds: float = 0.0
	var synced: bool = true
	var use_native: bool = true
	var native: RefCounted = null
	var native_epoch: int = -1


# Returns an unconfigured NativeShotOdds, or null. Unset, every query is GDScript.
static var native_factory: Callable = Callable()
# Bumped by attach_native: each query takes a fresh kernel from the factory then.
static var _native_epoch: int = 0
static var _worker := Query.new()

static var _built: bool = false
# Per spot (index fi * nx + xi): the first cell and how many.
static var _spot_first := PackedInt32Array()
static var _spot_count := PackedInt32Array()
# Per spot: its SET cell, the measured answer to "square and set on it".
static var _set_cell := PackedInt32Array()
# Per cell.
static var _odds := PackedFloat32Array()
static var _is_shot_sample := PackedByteArray()
static var _is_feed := PackedByteArray()
static var _one_timer := PackedByteArray()
static var _stance := PackedByteArray()
static var _in_seal_zone := PackedByteArray()
static var _offset := PackedFloat32Array()
static var _velocity := PackedFloat32Array()
static var _depth := PackedFloat32Array()
static var _square := PackedFloat32Array()
static var _travel := PackedFloat32Array()
static var _flight := PackedFloat32Array()
# Per cell × loft × aim, at REFERENCE_SPREAD_RAD.
static var _aim_odds := PackedFloat32Array()
static var _aims_per_cell: int = 0


# The odds of a shot from `release` at the net at `goal`, against the keeper at
# `keeper_pos` moving laterally at `keeper_vel_x` (world) in `stance` (Stance;
# stance_of reads it off a replicated goalie), facing `keeper_yaw` (his
# rotation_y; NAN when not read, and then his facing does not count).
static func shot_now(release: Vector3, goal: Vector3, keeper_pos: Vector3,
		keeper_vel_x: float, stance: int, keeper_yaw: float = NAN,
		query: Query = null) -> float:
	var q: Query = _query(query)
	if not _weigh_shot_now(q, release, goal, keeper_pos, keeper_vel_x, stance, keeper_yaw):
		return 0.0
	return q.odds


# The odds of a shot from `release` against a keeper square, still and upright on
# it: what a carry he tracks the whole way arrives at. That situation is measured
# (the SET cells), so it is read from them alone: a feed cell can show the same
# visible keeper and a different outcome, from history no read carries.
static func shot_set(release: Vector3, goal: Vector3, query: Query = null) -> float:
	var local: Vector2 = _local(release, goal)
	if local.y <= 0.0:
		return 0.0
	_build()
	var q: Query = _query(query)
	_weigh(q, local, false, false, Stance.UPRIGHT, 0.0, 0.0, NAN, NAN, true)
	return q.odds if q.count > 0 else 0.0


# The replicated goalie's Stance.
static func stance_of(keeper: GoalieNetworkState, goal: Vector3) -> int:
	if keeper.post_seal_x_sign(goal.z) != 0.0:
		return Stance.POST_SEAL
	return Stance.DOWN if keeper.is_down() else Stance.UPRIGHT


# The odds of the receiver's shot off a pass from `passer` to `receiver` at
# `speed`, the keeper at `keeper_pos` square on the passer. `one_timer`: the
# receiver one-times it; otherwise he catches and charges.
static func feed(passer: Vector3, receiver: Vector3, speed: float, goal: Vector3,
		keeper_pos: Vector3, one_timer: bool, query: Query = null) -> float:
	var q: Query = _query(query)
	if not _weigh_feed(q, passer, receiver, speed, goal, keeper_pos, one_timer):
		return 0.0
	return q.odds


# The odds of the receiver's one-timer off that feed when he does not pick the
# line — a deflection, which leaves anywhere across the mouth: the mean over
# every aim and loft.
static func feed_unaimed(passer: Vector3, receiver: Vector3, speed: float, goal: Vector3,
		keeper_pos: Vector3, query: Query = null) -> float:
	var q: Query = _query(query)
	if not _weigh_feed(q, passer, receiver, speed, goal, keeper_pos, true):
		return 0.0
	_blend_aims(q)
	var sum: float = 0.0
	for v: float in q.blend:
		sum += v
	return sum / float(q.blend.size())


# The shot to fire from `release` against the keeper as shot_now reads him, into
# `out`. `out.aim` is INF when there is no shot from here.
static func pick_shot_now(release: Vector3, goal: Vector3, keeper_pos: Vector3,
		keeper_vel_x: float, stance: int, out: Pick, keeper_yaw: float = NAN,
		query: Query = null) -> void:
	out.odds = 0.0
	out.aim = Vector3.INF
	out.loft = ShotMechanics.ELEVATION_FLAT
	var q: Query = _query(query)
	if not _weigh_shot_now(q, release, goal, keeper_pos, keeper_vel_x, stance, keeper_yaw):
		return
	_blend_aims(q)
	var best: int = 0
	for i: int in q.blend.size():
		if q.blend[i] > q.blend[best]:
			best = i
	var n: int = AIShotFieldData.AIM_POINTS
	var mirror: float = -signf(goal.z)
	out.odds = q.blend[best]
	out.loft = LOFTS[best / n]
	out.aim = Vector3(goal.x + aim_x(best % n) * mirror, 0.0, goal.z)


# shot_now's odds from the best aim when the crossing scatters by `spread_rad`
# instead of REFERENCE_SPREAD_RAD: the measured open sets re-read at that spread.
# Re-parses the cells it weighs, so it is for a once-per-shot read (the xG stat),
# never a per-tick one.
static func shot_now_at_spread(release: Vector3, goal: Vector3, keeper_pos: Vector3,
		keeper_vel_x: float, stance: int, spread_rad: float,
		keeper_yaw: float = NAN, query: Query = null) -> float:
	var q: Query = _query(query)
	if not _weigh_shot_now(q, release, goal, keeper_pos, keeper_vel_x, stance, keeper_yaw):
		return 0.0
	var sigma_m: float = spread_rad \
			* maxf(Vector2(release.x - goal.x, release.z - goal.z).length(), 0.5)
	_sync_cells(q)
	var blend := PackedFloat32Array()
	blend.resize(_aims_per_cell)
	blend.fill(0.0)
	for j: int in q.cells.size():
		var t: PackedStringArray = AIShotFieldData.ROWS[q.cells[j]].split("\t")
		for li: int in LOFTS.size():
			var pattern: String = t[23 + li]
			for i: int in pattern.length():
				blend[li * AIShotFieldData.AIM_POINTS + i] += \
						q.weights[j] * aim_odds(pattern, i, sigma_m)
	var best: float = 0.0
	for v: float in blend:
		best = maxf(best, v)
	return best


# The odds a shot from `release` at an EMPTY net at `goal` goes in: aimed at the
# middle, the crossing scattering by `spread_rad` over the range. No goalie, so
# nothing measured: it is where the puck lands.
static func empty_net(release: Vector3, goal: Vector3,
		spread_rad: float = REFERENCE_SPREAD_RAD) -> float:
	var mirror: float = -signf(goal.z)
	var range_m: float = Vector2(release.x - goal.x, release.z - goal.z).length()
	if (release.z - goal.z) * mirror <= 0.0:
		return 0.0
	var reach: float = GameRules.NET_HALF_WIDTH - GameRules.NET_POST_RADIUS \
			- GameRules.PUCK_COLLISION_RADIUS
	var sigma_m: float = spread_rad * maxf(range_m, 0.5)
	return _erf(reach / (sigma_m * sqrt(2.0)))


# Lateral aim (m, in the net's own frame) of aim sample `i` post to post.
static func aim_x(i: int) -> float:
	var reach: float = GameRules.NET_HALF_WIDTH - GameRules.NET_POST_RADIUS \
			- GameRules.PUCK_COLLISION_RADIUS
	return lerpf(-reach, reach, float(i) / float(AIShotFieldData.AIM_POINTS - 1))


static func _weigh_shot_now(q: Query, release: Vector3, goal: Vector3, keeper_pos: Vector3,
		keeper_vel_x: float, stance: int, keeper_yaw: float) -> bool:
	var local: Vector2 = _local(release, goal)
	if local.y <= 0.0:
		return false
	_build()
	var mirror: float = -signf(goal.z)
	var k := Vector3(keeper_pos.x, 0.0, keeper_pos.z)
	var offset: float = (k.x - AIGoalieModel.goalie_arc_match_x(k, goal, release)) * mirror
	var square: float = NAN if is_nan(keeper_yaw) else squareness(k, keeper_yaw, release)
	_weigh(q, local, false, false, stance, offset, keeper_vel_x * mirror,
			_depth_of(k, goal), square, false,
			1 if AIGoalieModel.in_post_seal_zone(release, goal) else 0)
	return q.count > 0


# The signed angle (rad) from a keeper at `keeper` facing `yaw` (rotation_y) to
# the bearing of `release`: 0 is square on the shot. Frame-free, since the
# field's frame is the world's turned about the net.
static func squareness(keeper: Vector3, yaw: float, release: Vector3) -> float:
	return Vector2(-sin(yaw), -cos(yaw)).angle_to(
			Vector2(release.x - keeper.x, release.z - keeper.z))


static func _depth_of(keeper: Vector3, goal: Vector3) -> float:
	return Vector2(keeper.x - goal.x, keeper.z - goal.z).length()


# `world` in the field's frame: (lateral, metres out from the goal line).
static func _local(world: Vector3, goal: Vector3) -> Vector2:
	var mirror: float = -signf(goal.z)
	return Vector2((world.x - goal.x) * mirror, (world.z - goal.z) * mirror)


static func _weigh_feed(q: Query, passer: Vector3, receiver: Vector3, speed: float,
		goal: Vector3, keeper_pos: Vector3, one_timer: bool) -> bool:
	_build()
	var mirror: float = -signf(goal.z)
	var local := Vector2((receiver.x - goal.x) * mirror, (receiver.z - goal.z) * mirror)
	if local.y <= 0.0:
		return false
	var k := Vector3(keeper_pos.x, 0.0, keeper_pos.z)
	var travel: float = (AIGoalieModel.goalie_arc_match_x(k, goal, receiver) - k.x) * mirror
	var flight: float = passer.distance_to(receiver) / maxf(speed, 0.1)
	_weigh(q, local, true, one_timer, Stance.UPRIGHT, travel, flight)
	return q.count > 0


static func _query(query: Query) -> Query:
	return query if query != null else _worker


# `q`'s matched cells and weights, fetched from its kernel when the kernel ran it.
static func _sync_cells(q: Query) -> void:
	if q.synced:
		return
	q.cells = q.native.get_cells()
	q.weights = q.native.get_weights()
	q.synced = true


static func _blend_aims(q: Query) -> void:
	_sync_cells(q)
	q.blend.resize(_aims_per_cell)
	q.blend.fill(0.0)
	for j: int in q.cells.size():
		var base: int = q.cells[j] * _aims_per_cell
		var w: float = q.weights[j]
		for i: int in _aims_per_cell:
			q.blend[i] += w * _aim_odds[base + i]


# Fills the query scratch with the matching cells and their normalized weights:
# bilinear over the four spots around `local`, a kernel over the keeper state
# within each. A feed's state is (a, b) = (travel, flight); a shot's is (a, b) =
# (offset, velocity) plus `depth` and `square`, each left out of the kernel when
# NAN, and a sealed keeper's `in_seal_zone` (0 / 1). `set_query`: each spot's SET
# cell alone.
static func _weigh(q: Query, local: Vector2, is_feed: bool, one_timer: bool, stance: int,
		a: float, b: float, depth: float = NAN, square: float = NAN,
		set_query: bool = false, in_seal_zone: int = 0) -> void:
	if q.native_epoch != _native_epoch:
		q.native_epoch = _native_epoch
		q.native = _new_native() if q.use_native else null
	if q.native != null:
		q.odds = q.native.weigh(local.x, local.y, is_feed, one_timer, stance, a, b, depth,
				square, set_query, in_seal_zone)
		q.count = q.native.get_count()
		q.synced = false
		return
	q.synced = true
	q.odds = 0.0
	q.cells.clear()
	q.weights.clear()
	var xs: Array[float] = AIShotFieldData.SPOT_X
	var fs: Array[float] = AIShotFieldData.SPOT_FWD
	var xi: int = _bracket(xs, local.x)
	var fi: int = _bracket(fs, local.y)
	var tx: float = clampf((local.x - xs[xi]) / (xs[xi + 1] - xs[xi]), 0.0, 1.0)
	var tf: float = clampf((local.y - fs[fi]) / (fs[fi + 1] - fs[fi]), 0.0, 1.0)
	var total: float = 0.0
	for corner: int in 4:
		var w: float = (tx if corner & 1 else 1.0 - tx) * (tf if corner >> 1 else 1.0 - tf)
		if w <= 0.0:
			continue
		var spot: int = (fi + (corner >> 1)) * xs.size() + xi + (corner & 1)
		if set_query:
			if _set_cell[spot] >= 0:
				q.cells.append(_set_cell[spot])
				q.weights.append(w)
				total += w
		else:
			total += _weigh_spot(q, spot, w, is_feed, one_timer, stance, a, b, depth, square,
					in_seal_zone)
	if total <= 0.0:
		q.cells.clear()
		q.weights.clear()
		q.count = 0
		return
	var v: float = 0.0
	for j: int in q.weights.size():
		q.weights[j] /= total
		v += q.weights[j] * _odds[q.cells[j]]
	q.count = q.cells.size()
	# The weights are float32, so a sum of certain cells can land a hair past 1.
	q.odds = minf(v, 1.0)


# Appends one spot's matching cells and returns the weight they carry: the
# spot's bilinear `spot_weight` times its evidence, the kernel mass of its cells
# capped at one sample's. A spot whose only cell is far from the query then
# yields to a neighbour with a close one, instead of answering for its whole
# share. 0 when the spot has no matching cell.
static func _weigh_spot(q: Query, spot: int, spot_weight: float, is_feed: bool,
		one_timer: bool, stance: int, a: float, b: float, depth: float = NAN,
		square: float = NAN, in_seal_zone: int = 0) -> float:
	var ha: float = TRAVEL_BANDWIDTH_M if is_feed else OFFSET_BANDWIDTH_M
	var hb: float = FLIGHT_BANDWIDTH_S if is_feed else VELOCITY_BANDWIDTH_M_S
	var first: int = q.cells.size()
	var wsum: float = 0.0
	var nearest: int = -1
	var nearest_d2: float = INF
	for c: int in range(_spot_first[spot], _spot_first[spot] + _spot_count[spot]):
		var ca: float
		var cb: float
		if is_feed:
			if _is_feed[c] == 0 or (_one_timer[c] == 1) != one_timer:
				continue
			ca = _travel[c]
			cb = _flight[c]
		else:
			if _is_shot_sample[c] == 0 or _stance[c] != stance:
				continue
			if stance == Stance.POST_SEAL and _in_seal_zone[c] != in_seal_zone:
				continue
			ca = _offset[c]
			cb = _velocity[c]
		var da: float = (a - ca) / ha
		var db: float = (b - cb) / hb
		var d2: float = da * da + db * db
		if not is_feed:
			if not is_nan(depth):
				var dd: float = (depth - _depth[c]) / DEPTH_BANDWIDTH_M
				d2 += dd * dd
			if not is_nan(square):
				var ds: float = angle_difference(_square[c], square) / SQUARE_BANDWIDTH_RAD
				d2 += ds * ds
		var w: float = exp(-0.5 * d2)
		q.cells.append(c)
		q.weights.append(w)
		wsum += w
		if d2 < nearest_d2:
			nearest_d2 = d2
			nearest = c
	if nearest < 0:
		return 0.0
	if wsum < _MIN_WEIGHT:
		q.cells.resize(first)
		q.weights.resize(first)
		q.cells.append(nearest)
		q.weights.append(spot_weight * _MIN_WEIGHT)
		return spot_weight * _MIN_WEIGHT
	var share: float = spot_weight * minf(wsum, 1.0)
	for j: int in range(first, q.weights.size()):
		q.weights[j] *= share / wsum
	return share


# Index of the grid interval holding `v`, clamped to the grid.
static func _bracket(grid: Array[float], v: float) -> int:
	for i: int in range(grid.size() - 2, -1, -1):
		if v >= grid[i]:
			return i
	return 0


static func _build() -> void:
	if _built:
		return
	_built = true
	var spots: int = AIShotFieldData.SPOT_X.size() * AIShotFieldData.SPOT_FWD.size()
	_spot_first.resize(spots)
	_spot_count.resize(spots)
	_spot_first.fill(0)
	_spot_count.fill(0)
	_set_cell.resize(spots)
	_set_cell.fill(-1)
	var n: int = AIShotFieldData.ROWS.size()
	_aims_per_cell = LOFTS.size() * AIShotFieldData.AIM_POINTS
	_odds.resize(n)
	_offset.resize(n)
	_velocity.resize(n)
	_depth.resize(n)
	_square.resize(n)
	_travel.resize(n)
	_flight.resize(n)
	_is_shot_sample.resize(n)
	_is_feed.resize(n)
	_one_timer.resize(n)
	_stance.resize(n)
	_in_seal_zone.resize(n)
	_aim_odds.resize(n * _aims_per_cell)
	for c: int in n:
		var t: PackedStringArray = AIShotFieldData.ROWS[c].split("\t")
		var spot: int = AIShotFieldData.SPOT_FWD.find(float(t[2])) * AIShotFieldData.SPOT_X.size() \
				+ AIShotFieldData.SPOT_X.find(float(t[1]))
		if _spot_count[spot] == 0:
			_spot_first[spot] = c
		_spot_count[spot] += 1
		var kind: String = t[3]
		var mode: String = t[4]
		var release := Vector3(float(t[7]), 0.0, _FIELD_GOAL.z + float(t[8]))
		var pre := Vector3(float(t[9]), 0.0, float(t[10]))
		var now := Vector3(float(t[16]), 0.0, float(t[17]))
		_is_feed[c] = 1 if kind == "FEED" else 0
		_one_timer[c] = 1 if mode == "O" else 0
		# A feed caught and charged is also the keeper as the receiver finds him.
		_is_shot_sample[c] = 1 if kind != "FEED" or mode == "K" else 0
		var probe := GoalieNetworkState.new()
		probe.state_enum = int(float(t[19]))
		_stance[c] = stance_of(probe, _FIELD_GOAL)
		_in_seal_zone[c] = 1 if AIGoalieModel.in_post_seal_zone(release, _FIELD_GOAL) else 0
		_offset[c] = now.x - AIGoalieModel.goalie_arc_match_x(now, _FIELD_GOAL, release)
		_velocity[c] = float(t[21])
		_depth[c] = _depth_of(now, _FIELD_GOAL)
		_square[c] = squareness(now, float(t[18]), release)
		if kind == "SET":
			_set_cell[spot] = c
		var receiver := Vector3(float(t[1]), 0.0, _FIELD_GOAL.z + float(t[2]))
		var passer := Vector3(float(t[5]), 0.0, receiver.z)
		_travel[c] = AIGoalieModel.goalie_arc_match_x(pre, _FIELD_GOAL, receiver) - pre.x
		_flight[c] = passer.distance_to(receiver) / maxf(float(t[6]), 0.1)
		var sigma_m: float = REFERENCE_SPREAD_RAD \
				* maxf(Vector2(release.x, release.z - _FIELD_GOAL.z).length(), 0.5)
		var best: float = 0.0
		for li: int in LOFTS.size():
			var pattern: String = t[23 + li]
			for i: int in pattern.length():
				var p: float = aim_odds(pattern, i, sigma_m)
				_aim_odds[c * _aims_per_cell + li * AIShotFieldData.AIM_POINTS + i] = p
				best = maxf(best, p)
		_odds[c] = best


# Builds the field, so nothing reads it half-built: run once on the main thread
# before the AI worker starts.
static func prepare() -> void:
	_build()


# Takes `native_factory` as it now stands: every query swaps in a fresh kernel
# from it on its next read, or drops its kernel when there is none.
static func attach_native() -> void:
	_native_epoch += 1


# A kernel from `native_factory` loaded with the built field, or null.
static func _new_native() -> RefCounted:
	if not native_factory.is_valid():
		return null
	_build()
	var native: RefCounted = native_factory.call()
	if native == null:
		return null
	native.set_grid(PackedFloat64Array(AIShotFieldData.SPOT_X),
			PackedFloat64Array(AIShotFieldData.SPOT_FWD), _spot_first, _spot_count, _set_cell)
	native.set_cells(_odds, _is_shot_sample, _is_feed, _one_timer, _stance, _in_seal_zone,
			_offset, _velocity, _depth, _square, _travel, _flight)
	native.set_bandwidths(OFFSET_BANDWIDTH_M, VELOCITY_BANDWIDTH_M_S, DEPTH_BANDWIDTH_M,
			SQUARE_BANDWIDTH_RAD, TRAVEL_BANDWIDTH_M, FLIGHT_BANDWIDTH_S, _MIN_WEIGHT,
			Stance.POST_SEAL)
	return native


# The best aim's goal fraction over `patterns` (FLAT / LOW / HIGH outcome strings
# post to post) when the crossing scatters by `sigma_m` about the aim, a crossing
# scoring as the nearest measured aim did.
static func best_odds(patterns: PackedStringArray, sigma_m: float) -> float:
	var best: float = 0.0
	for p: String in patterns:
		for i: int in p.length():
			best = maxf(best, aim_odds(p, i, sigma_m))
	return best


static func aim_odds(pattern: String, i: int, sigma_m: float) -> float:
	var n: int = pattern.length()
	var reach: float = GameRules.NET_HALF_WIDTH - GameRules.NET_POST_RADIUS \
			- GameRules.PUCK_COLLISION_RADIUS
	var step: float = 2.0 * reach / float(n - 1)
	var aim: float = -reach + step * float(i)
	var s: float = maxf(sigma_m, 1e-4) * sqrt(2.0)
	var p: float = 0.0
	for j: int in n:
		if pattern[j] != "G":
			continue
		var x: float = -reach + step * float(j)
		p += 0.5 * (_erf((x + 0.5 * step - aim) / s) - _erf((x - 0.5 * step - aim) / s))
	return p


# erf via Abramowitz & Stegun 7.1.26 (|error| < 1.5e-7). Its own copy: this file is
# a leaf the evaluators read, so it may not read AIActionScoring's.
static func _erf(x: float) -> float:
	var ax: float = absf(x)
	var t: float = 1.0 / (1.0 + 0.3275911 * ax)
	var poly: float = t * (0.254829592 + t * (-0.284496736 + t * (1.421413741
			+ t * (-1.453152027 + t * 1.061405429))))
	return signf(x) * (1.0 - poly * exp(-ax * ax))
