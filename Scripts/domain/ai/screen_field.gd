class_name AIScreenField

# The screen field (AIScreenFieldData, generated by
# tests/instruments/ai/test_generate_screen_field.gd): what a body in front of
# the live goalie does to a charged wrister at a keeper set square on the
# carrier. Per measured spot, the share of its shots that scored with nobody in
# front and with a body at each station on and beside the release's line to the
# net. Read in the frame of the net being attacked. Built once, lazily. A leaf:
# reads no evaluator.

static var _built: bool = false
# Per spot: the unscreened share scored, then per station (along-major) the
# screened one.
static var _base := PackedFloat32Array()
static var _station := PackedFloat32Array()


# How much a body at `body` adds to a shot released at `release` on the net at
# `attacking_goal`, the keeper at `keeper_pos`: of the shots he stops with
# nobody in front, the share a screen there turns into goals. A body screens
# only while it hides the release from him (AIScreenRead.hides_release, his own
# test, `cfg`); the field measured a screen off the line by as little as 0.4 m
# adding nothing, so the value is the one measured on the line, at the station
# nearest the body's distance out from the goal along it. 0 for a body that
# hides nothing, or stands where a screen was measured to be worth nothing.
static func uplift(release: Vector3, attacking_goal: Vector3, keeper_pos: Vector3,
		body: Vector3, cfg: GoalieScreenRules.ScreenConfig) -> float:
	_build()
	if not AIScreenRead.hides_release(body, keeper_pos, release, cfg):
		return 0.0
	var dir := Vector3(release.x - attacking_goal.x, 0.0, release.z - attacking_goal.z)
	var reach: float = dir.length()
	if reach < 0.001:
		return 0.0
	var along: float = Vector3(body.x - attacking_goal.x, 0.0, body.z - attacking_goal.z) \
			.dot(dir / reach)
	var alongs: Array[float] = AIScreenFieldData.STATION_ALONG_M
	if along >= reach or along < alongs[0] - _half_gap(alongs, 0) \
			or along > alongs[-1] + _half_gap(alongs, alongs.size() - 2):
		return 0.0
	var spot: int = _spot_of(release, attacking_goal)
	var base: float = _base[spot]
	var on_line: int = _nearest(AIScreenFieldData.STATION_ACROSS_M, 0.0)
	var screened: float = _station[(spot * alongs.size() + _nearest(alongs, along))
			* AIScreenFieldData.STATION_ACROSS_M.size() + on_line]
	if screened <= base or base >= 1.0:
		return 0.0
	return (screened - base) / (1.0 - base)


# The best of `bodies`' screens for a shot from `release` (uplift): a second
# body hides nothing the first has not.
static func best_uplift(release: Vector3, attacking_goal: Vector3, keeper_pos: Vector3,
		bodies: Array[Vector3], cfg: GoalieScreenRules.ScreenConfig) -> float:
	var best: float = 0.0
	for b: Vector3 in bodies:
		best = maxf(best, uplift(release, attacking_goal, keeper_pos, b, cfg))
	return best


# The distance out along a release's line to the net its spot's screen was
# measured worth most at (the on-line station; NAN where none was worth
# anything): where a screener goes.
static func best_station_along(release: Vector3, attacking_goal: Vector3) -> float:
	_build()
	var spot: int = _spot_of(release, attacking_goal)
	var alongs: Array[float] = AIScreenFieldData.STATION_ALONG_M
	var on_line: int = _nearest(AIScreenFieldData.STATION_ACROSS_M, 0.0)
	var best: float = _base[spot]
	var at: float = NAN
	for i: int in alongs.size():
		var v: float = _station[(spot * alongs.size() + i)
				* AIScreenFieldData.STATION_ACROSS_M.size() + on_line]
		if v > best:
			best = v
			at = alongs[i]
	return at


static func _half_gap(grid: Array[float], i: int) -> float:
	return 0.5 * (grid[i + 1] - grid[i])


static func _spot_of(release: Vector3, attacking_goal: Vector3) -> int:
	var out: float = (attacking_goal.z - release.z) * signf(attacking_goal.z)
	return _nearest(AIScreenFieldData.SPOT_FWD, out) * AIScreenFieldData.SPOT_X.size() \
			+ _nearest(AIScreenFieldData.SPOT_X, release.x)


static func _nearest(grid: Array[float], v: float) -> int:
	var best: int = 0
	for i: int in grid.size():
		if absf(grid[i] - v) < absf(grid[best] - v):
			best = i
	return best


static func _build() -> void:
	if _built:
		return
	_built = true
	var spots: int = AIScreenFieldData.SPOT_X.size() * AIScreenFieldData.SPOT_FWD.size()
	var per: int = AIScreenFieldData.STATION_ALONG_M.size() * AIScreenFieldData.STATION_ACROSS_M.size()
	_base.resize(spots)
	_base.fill(0.0)
	_station.resize(spots * per)
	_station.fill(0.0)
	for r: String in AIScreenFieldData.ROWS:
		var f: PackedStringArray = r.split("\t")
		var spot: int = _nearest(AIScreenFieldData.SPOT_FWD, float(f[2])) \
				* AIScreenFieldData.SPOT_X.size() + _nearest(AIScreenFieldData.SPOT_X, float(f[1]))
		var scored: float = float(f[5]) / maxf(float(f[6]), 1.0)
		if float(f[3]) < 0.0:
			_base[spot] = scored
			continue
		_station[(spot * AIScreenFieldData.STATION_ALONG_M.size()
				+ _nearest(AIScreenFieldData.STATION_ALONG_M, float(f[3])))
				* AIScreenFieldData.STATION_ACROSS_M.size()
				+ _nearest(AIScreenFieldData.STATION_ACROSS_M, float(f[4]))] = scored
