class_name AIScreenField

# The screen field (AIScreenFieldData, generated by
# tests/instruments/ai/test_generate_screen_field.gd): what a body in front of
# the live goalie does to a charged wrister at a keeper set square on the
# carrier. Read in the frame of the net being attacked. Built once, lazily. A
# leaf: reads no evaluator.
#
# A measured cell is 24 shots, too few to read alone (0–6 goals), so the read is
# fitted over all of them: on the line, the share a body there scores is a
# product of how central the release is, how far out it is and how far out the
# body stands (a Poisson log-linear fit by iterative proportional fitting, which
# the measured cells fit within their own noise), and with nobody in front the
# share pooled over every spot. Off the line the field measured nothing, so it is
# not read.

# IPF sweeps over the fit's three factors; it settles well inside this.
const FIT_SWEEPS: int = 50

static var _built: bool = false
# The unscreened share scored, pooled over the spots; per spot and on-line
# station (along-major), the fitted screened one.
static var _base: float = 0.0
static var _station := PackedFloat32Array()


# How much a body at `body` adds to a shot released at `release` on the net at
# `attacking_goal`, the keeper at `keeper_pos`: of the shots he stops with
# nobody in front, the share a screen there turns into goals. A body screens
# only while it hides the release from him (AIScreenRead.hides_release, his own
# test, `cfg`); the field measured a screen off the line by as little as 0.4 m
# adding nothing, so the value is the one measured on the line, at the station
# nearest the body's distance out from the goal along it, read between the
# measured spots round the release (AIFieldGrid). 0 for a body that hides
# nothing, or stands where a screen was measured to be worth nothing.
static func uplift(release: Vector3, attacking_goal: Vector3, keeper_pos: Vector3,
		body: Vector3, cfg: GoalieScreenRules.ScreenConfig) -> float:
	_build()
	if not AIScreenRead.hides_release(body, keeper_pos, release, cfg):
		return 0.0
	var dir := Vector3(release.x - attacking_goal.x, 0.0, release.z - attacking_goal.z)
	var reach: float = dir.length()
	if reach < 0.001:
		return 0.0
	var along: float = Vector3(body.x - attacking_goal.x, 0.0, body.z - attacking_goal.z) \
			.dot(dir / reach)
	var alongs: Array[float] = AIScreenFieldData.STATION_ALONG_M
	if along >= reach or along < alongs[0] - _half_gap(alongs, 0) \
			or along > alongs[-1] + _half_gap(alongs, alongs.size() - 2):
		return 0.0
	var station: int = _nearest(alongs, along)
	_fill_corners(release, attacking_goal)
	var v: float = 0.0
	for k: int in 4:
		var screened: float = _station[AIFieldGrid.spot[k] * alongs.size() + station]
		if screened > _base:
			v += AIFieldGrid.weight[k] * (screened - _base) / (1.0 - _base)
	return v


# The best of `bodies`' screens for a shot from `release` (uplift): a second
# body hides nothing the first has not.
static func best_uplift(release: Vector3, attacking_goal: Vector3, keeper_pos: Vector3,
		bodies: Array[Vector3], cfg: GoalieScreenRules.ScreenConfig) -> float:
	var best: float = 0.0
	for b: Vector3 in bodies:
		best = maxf(best, uplift(release, attacking_goal, keeper_pos, b, cfg))
	return best


# The distance out along a release's line to the net a screen was measured
# worth most at (the on-line station), read between the measured spots round
# the release (AIFieldGrid) by the weight of those where one was worth
# anything: where a screener goes. NAN where none of them was.
static func best_station_along(release: Vector3, attacking_goal: Vector3) -> float:
	_build()
	_fill_corners(release, attacking_goal)
	var w: float = 0.0
	var at: float = 0.0
	for k: int in 4:
		var a: float = _spot_best_along(AIFieldGrid.spot[k])
		if is_nan(a) or AIFieldGrid.weight[k] <= 0.0:
			continue
		w += AIFieldGrid.weight[k]
		at += AIFieldGrid.weight[k] * a
	return at / w if w > 0.0 else NAN


static func _spot_best_along(spot: int) -> float:
	var alongs: Array[float] = AIScreenFieldData.STATION_ALONG_M
	var best: float = _base
	var at: float = NAN
	for i: int in alongs.size():
		var v: float = _station[spot * alongs.size() + i]
		if v > best:
			best = v
			at = alongs[i]
	return at


static func _fill_corners(release: Vector3, attacking_goal: Vector3) -> void:
	AIFieldGrid.fill(AIScreenFieldData.SPOT_X, AIScreenFieldData.SPOT_FWD, release.x,
			(attacking_goal.z - release.z) * signf(attacking_goal.z))


static func _half_gap(grid: Array[float], i: int) -> float:
	return 0.5 * (grid[i + 1] - grid[i])


static func _nearest(grid: Array[float], v: float) -> int:
	var best: int = 0
	for i: int in grid.size():
		if absf(grid[i] - v) < absf(grid[best] - v):
			best = i
	return best


static func _build() -> void:
	if _built:
		return
	_built = true
	var xs: Array[float] = AIScreenFieldData.SPOT_X
	var outs: Array[float] = AIScreenFieldData.SPOT_FWD
	var alongs: Array[float] = AIScreenFieldData.STATION_ALONG_M
	# The fit's levels: |x| (the field is measured both sides, and a screen
	# reads the same mirrored), metres out, the body's station out.
	var cx: Array[float] = []
	for x: float in xs:
		if not cx.has(absf(x)):
			cx.append(absf(x))
	var on_line: int = _nearest(AIScreenFieldData.STATION_ACROSS_M, 0.0)
	var cells_x := PackedInt32Array()
	var cells_out := PackedInt32Array()
	var cells_along := PackedInt32Array()
	var goals := PackedFloat32Array()
	var shots := PackedFloat32Array()
	var base_goals: float = 0.0
	var base_shots: float = 0.0
	for r: String in AIScreenFieldData.ROWS:
		var f: PackedStringArray = r.split("\t")
		var g: float = float(f[5])
		var n: float = float(f[6])
		if float(f[3]) < 0.0:
			base_goals += g
			base_shots += n
			continue
		if _nearest(AIScreenFieldData.STATION_ACROSS_M, float(f[4])) != on_line:
			continue
		cells_x.append(_nearest(cx, absf(float(f[1]))))
		cells_out.append(_nearest(outs, float(f[2])))
		cells_along.append(_nearest(alongs, float(f[3])))
		goals.append(g)
		shots.append(n)
	_base = base_goals / maxf(base_shots, 1.0)
	var fx := PackedFloat32Array()
	fx.resize(cx.size())
	fx.fill(1.0)
	var fo := PackedFloat32Array()
	fo.resize(outs.size())
	fo.fill(1.0)
	var fa := PackedFloat32Array()
	fa.resize(alongs.size())
	fa.fill(1.0)
	var all_goals: float = 0.0
	var all_shots: float = 0.0
	for c: int in goals.size():
		all_goals += goals[c]
		all_shots += shots[c]
	var k0: float = all_goals / maxf(all_shots, 1.0)
	for _sweep: int in FIT_SWEEPS:
		fx = _fit_factor(fx, cells_x, k0, fx, fo, fa, cells_x, cells_out, cells_along, goals, shots)
		fo = _fit_factor(fo, cells_out, k0, fx, fo, fa, cells_x, cells_out, cells_along, goals, shots)
		fa = _fit_factor(fa, cells_along, k0, fx, fo, fa, cells_x, cells_out, cells_along, goals, shots)
	_station.resize(xs.size() * outs.size() * alongs.size())
	for o: int in outs.size():
		for xi: int in xs.size():
			var ax: int = _nearest(cx, absf(xs[xi]))
			for a: int in alongs.size():
				_station[(o * xs.size() + xi) * alongs.size() + a] = k0 * fx[ax] * fo[o] * fa[a]


# One IPF step: `factor` (indexed per cell by `level`) with each level scaled so
# the fit's goals over its cells match the measured ones.
static func _fit_factor(factor: PackedFloat32Array, level: PackedInt32Array, k0: float,
		fx: PackedFloat32Array, fo: PackedFloat32Array, fa: PackedFloat32Array,
		cx: PackedInt32Array, co: PackedInt32Array, ca: PackedInt32Array,
		goals: PackedFloat32Array, shots: PackedFloat32Array) -> PackedFloat32Array:
	var measured := PackedFloat32Array()
	measured.resize(factor.size())
	measured.fill(0.0)
	var fitted := PackedFloat32Array()
	fitted.resize(factor.size())
	fitted.fill(0.0)
	for c: int in goals.size():
		measured[level[c]] += goals[c]
		fitted[level[c]] += k0 * fx[cx[c]] * fo[co[c]] * fa[ca[c]] * shots[c]
	var out := PackedFloat32Array()
	out.resize(factor.size())
	for i: int in factor.size():
		out[i] = factor[i] * measured[i] / fitted[i] if fitted[i] > 0.0 else 0.0
	return out
