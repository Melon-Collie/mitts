class_name AITipField

# The tip field (AITipFieldData, generated by
# tests/instruments/ai/test_generate_tip_field.gd): what a net-front stick held
# to deflect does to a charged wrister on the ice at the live keeper set on the
# release. Per measured spot, per distance out the tipper stood on the
# release's line, per tip height, the share of tips that scored, his cursor
# swept across his front. Read in the frame of the net being attacked. Built
# once, lazily. A leaf: reads no evaluator.

static var _built: bool = false
# Per spot, along, level (level minor): goals over tips.
static var _odds := PackedFloat32Array()
# Per spot: whether the generator measured any cell there.
static var _measured: Array[bool] = []


# The odds a shot on the ice from `release` on the net at `attacking_goal`,
# tipped at `tip` at ShotMechanics elevation `level`, scores: read at the
# measured distance out nearest the tip's own from the goal's centre (the edge
# of the grid past it), between the measured spots round the release
# (AIFieldGrid).
static func odds(release: Vector3, attacking_goal: Vector3, tip: Vector3, level: int) -> float:
	_build()
	var along: int = _nearest(AITipFieldData.TIP_ALONG_M, Vector2(tip.x - attacking_goal.x,
			tip.z - attacking_goal.z).length())
	_fill_corners(release, attacking_goal)
	return _blended(along, level)


# The tip height that scores most often for the shot and tip of odds() — the
# lowest of those tied.
static func best_level(release: Vector3, attacking_goal: Vector3, tip: Vector3) -> int:
	_build()
	var along: int = _nearest(AITipFieldData.TIP_ALONG_M, Vector2(tip.x - attacking_goal.x,
			tip.z - attacking_goal.z).length())
	_fill_corners(release, attacking_goal)
	var best: int = 0
	var best_v: float = -1.0
	for level: int in _levels():
		var v: float = _blended(along, level)
		if v > best_v:
			best_v = v
			best = level
	return best


# odds() at best_level(): what a tip there is worth, tipped the way it scores.
static func best_odds(release: Vector3, attacking_goal: Vector3, tip: Vector3) -> float:
	return odds(release, attacking_goal, tip, best_level(release, attacking_goal, tip))


# A spot the generator measured nothing at (its carrier would stand in the
# boards) gives its share to the corners that were.
static func _blended(along: int, level: int) -> float:
	var v: float = 0.0
	var w: float = 0.0
	for k: int in 4:
		var spot: int = AIFieldGrid.spot[k]
		if not _measured[spot]:
			continue
		w += AIFieldGrid.weight[k]
		v += AIFieldGrid.weight[k] * _odds[(spot * AITipFieldData.TIP_ALONG_M.size() + along)
				* _levels() + level]
	return v / w if w > 0.0 else 0.0


static func _levels() -> int:
	return ShotMechanics.ELEVATION_HIGH + 1


static func _fill_corners(release: Vector3, attacking_goal: Vector3) -> void:
	AIFieldGrid.fill(AITipFieldData.SPOT_X, AITipFieldData.SPOT_FWD, release.x,
			(attacking_goal.z - release.z) * signf(attacking_goal.z))


static func _nearest(grid: Array[float], v: float) -> int:
	var best: int = 0
	for i: int in grid.size():
		if absf(grid[i] - v) < absf(grid[best] - v):
			best = i
	return best


# A distance out the generator skipped at a spot (a tipper within a metre of
# the release) reads the nearest one it measured there.
static func _build() -> void:
	if _built:
		return
	_built = true
	var spots: int = AITipFieldData.SPOT_X.size() * AITipFieldData.SPOT_FWD.size()
	var alongs: int = AITipFieldData.TIP_ALONG_M.size()
	_odds.resize(spots * alongs * _levels())
	_odds.fill(NAN)
	_measured.resize(spots)
	_measured.fill(false)
	for r: String in AITipFieldData.ROWS:
		var f: PackedStringArray = r.split("\t")
		var spot: int = _nearest(AITipFieldData.SPOT_FWD, float(f[2])) \
				* AITipFieldData.SPOT_X.size() + _nearest(AITipFieldData.SPOT_X, float(f[1]))
		_measured[spot] = true
		var outs: String = f[5]
		var tips: int = outs.length() - outs.count("-") - outs.count("x")
		_odds[(spot * alongs + _nearest(AITipFieldData.TIP_ALONG_M, float(f[3]))) * _levels()
				+ int(f[4])] = float(outs.count("G")) / maxf(float(tips), 1.0)
	for spot: int in spots:
		for level: int in _levels():
			for a: int in alongs:
				if is_nan(_odds[(spot * alongs + a) * _levels() + level]):
					_odds[(spot * alongs + a) * _levels() + level] = _measured_near(spot, a, level)


static func _measured_near(spot: int, along: int, level: int) -> float:
	var alongs: int = AITipFieldData.TIP_ALONG_M.size()
	for step: int in alongs:
		for a: int in [along - step, along + step]:
			if a >= 0 and a < alongs and not is_nan(_odds[(spot * alongs + a) * _levels() + level]):
				return _odds[(spot * alongs + a) * _levels() + level]
	return 0.0
