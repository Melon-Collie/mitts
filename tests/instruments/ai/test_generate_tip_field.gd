extends "res://tests/instruments/keeper/test_net_front_tips.gd"

# ── The TIP FIELD generator (docs/bot-net-front-offense-plan.md, steps 2c and 5) ──
# What a net-front stick held to deflect does to a shot at the live keeper: from
# each release spot, a charged wrister (AIBotMechanics.WRISTER_SHOT_SPEED_M_S)
# through a tipper standing on the release's line to the net at each distance
# out, tipping at each height, his cursor swept across his front
# (test_net_front_tips.gd's sweep, the keeper settled before each shot). Each
# cell is a row: the outcome of every placement. Written as
# Scripts/domain/ai/generated/tip_field_data.gd by
# .claude/hooks/generate-tip-field.sh; re-run when the goalie or the tip changes
# (test_tip_field_is_current.gd says when). Never hand-edit the output.
#
#   MITTS_TIP_SHARD=i MITTS_TIP_SHARDS=n   measure every n-th cell from i
#   MITTS_TIP_MERGE=1                      merge the shards

const Fingerprint := preload("res://tests/unit/ai/tip_field_fingerprint.gd")

const OUT_PATH: String = "res://Scripts/domain/ai/generated/tip_field_data.gd"
const SHARD_PATH: String = "user://tip_field_shard_%d.txt"
# The screen field's release spots, and the tipper's distance out along each
# release's line from the crease top to the screen's depth.
const SPOT_X: Array[float] = [-8.0, -4.0, 0.0, 4.0, 8.0]
const SPOT_FWD: Array[float] = [6.0, 9.5, 15.0, 19.5]
const TIP_ALONG_M: Array[float] = [2.5, 3.5, 5.0]


func test_the_aim_window() -> void:
	pass


func test_tip_conversion() -> void:
	pass


# Every cell, in a fixed order: [spot_x, spot_fwd, along, level].
func _cells() -> Array:
	var out: Array = []
	for fwd: float in SPOT_FWD:
		for x: float in SPOT_X:
			var at := Vector2(x, GOAL_Z + fwd)
			if GameRules.clamp_to_rink_inner(at, 0.5).distance_to(at) > 1e-4:
				continue
			for along: float in TIP_ALONG_M:
				if along >= fwd - 1.0:
					continue
				for level: int in TIP_LEVELS:
					out.append([x, fwd, along, level])
	return out


# Where a cell's tipper stands, as (x, metres out): on the release's line to the
# goal's centre, `along` out from it.
static func tip_spot(x: float, fwd: float, along: float) -> Vector2:
	var dir: Vector2 = Vector2(x, fwd).normalized()
	return dir * along


func _cell_row(index: int, cell: Array) -> String:
	var shooter: Vector3 = _world(Vector2(cell[0], cell[1]))
	var spot: Vector2 = tip_spot(cell[0], cell[1], cell[2])
	var outs: String = ""
	var c: float = -CURSOR_SPAN_M
	while c <= CURSOR_SPAN_M + 0.001:
		var r: Array = _row(shooter, spot, AIBotMechanics.WRISTER_SHOT_SPEED_M_S, cell[3], c)
		outs += r[2]
		c += CURSOR_STEP_M
	return "%d\t%.2f\t%.2f\t%.2f\t%d\t%s" % [index, cell[0], cell[1], cell[2], cell[3], outs]


func test_measure_a_shard() -> void:
	var shards: int = int(OS.get_environment("MITTS_TIP_SHARDS"))
	if shards <= 0:
		pending("set MITTS_TIP_SHARD / MITTS_TIP_SHARDS (generate-tip-field.sh)")
		return
	var shard: int = int(OS.get_environment("MITTS_TIP_SHARD"))
	var cells: Array = _cells()
	var lines: PackedStringArray = []
	for i: int in cells.size():
		if i % shards == shard:
			lines.append(_cell_row(i, cells[i]))
	var f := FileAccess.open(SHARD_PATH % shard, FileAccess.WRITE)
	assert_not_null(f, "can write shard %d" % shard)
	if f != null:
		f.store_string("\n".join(lines) + "\n")
		f.close()
	gut.p("shard %d/%d: %d cells" % [shard, shards, lines.size()])


func test_merge_the_shards() -> void:
	if OS.get_environment("MITTS_TIP_MERGE") != "1":
		pending("set MITTS_TIP_MERGE=1 (generate-tip-field.sh)")
		return
	var shards: int = int(OS.get_environment("MITTS_TIP_SHARDS"))
	var rows: Array[String] = []
	rows.resize(_cells().size())
	for shard: int in shards:
		for line: String in FileAccess.get_file_as_string(SHARD_PATH % shard).split("\n"):
			if not line.is_empty():
				rows[int(line.get_slice("\t", 0))] = line
	for i: int in rows.size():
		assert_false(rows[i].is_empty(), "cell %d was measured" % i)
	var out: PackedStringArray = [
		"class_name AITipFieldData",
		"",
		"# GENERATED by tests/instruments/ai/test_generate_tip_field.gd through",
		"# .claude/hooks/generate-tip-field.sh — never hand-edit. What a net-front",
		"# stick held to deflect does to a charged wrister at the live keeper settled",
		"# on the release. Row columns: index, spot x, spot metres out, the tipper's",
		"# distance out from the goal's centre along the release's line, the tip's",
		"# ShotMechanics elevation, and one outcome per cursor placement across his",
		"# front (CURSOR_SPAN_M either side at CURSOR_STEP_M): G goal, s save, P post,",
		"# w wide, b off his body, - not touched, x touched twice.",
		"",
		"const FINGERPRINT: String = \"%s\"" % Fingerprint.compute(),
		"const SPOT_X: Array[float] = %s" % [str(SPOT_X)],
		"const SPOT_FWD: Array[float] = %s" % [str(SPOT_FWD)],
		"const TIP_ALONG_M: Array[float] = %s" % [str(TIP_ALONG_M)],
		"const ROWS: Array[String] = [",
	]
	for r: String in rows:
		out.append("\t\"%s\"," % r.replace("\t", "\\t"))
	out.append("]")
	var f := FileAccess.open(OUT_PATH, FileAccess.WRITE)
	assert_not_null(f, "can write %s" % OUT_PATH)
	if f != null:
		f.store_string("\n".join(out) + "\n")
		f.close()
	gut.p("tip field: %d cells written to %s" % [rows.size(), OUT_PATH])
