extends GutTest

# The one-chance interception read (docs/strip-interception-plan.md), exported
# for fitting by tools/strip_interception_fit.py: for each saved run
# (MITTS_HORIZON_RUNS, test_defender_race_truth.gd's save format) whether the
# puck was lost, and for each defender his best spare time on the carrier's
# planned path — over its samples, the puck's time there less the time his stick
# takes to get within his blade's reach of it, read from the run's start on his
# arrival clock — when that point comes, and the first sample he reaches with no
# time to spare and with FIRST_SET_S (his first chance; -1 when none). The
# planned path is <runs>.planned when it exists (the interceptor's dry runs),
# else the puck's path as recorded, which stops at a loss. `current` is the
# strip read's keep along it as −ln(keep). Writes
# .preview/strip_interception/runs.csv; with MITTS_WRITE_INTERCEPT_TRUTH=1 and
# planned paths, also the strip read's truth file (one of each staging's
# repeats). Reports only.

const Duel := preload("res://tests/unit/ai/duel_harness.gd")
const OUT_DIR: String = "res://.preview/strip_interception"
const TRUTH_PATH: String = "res://tests/unit/ai/data/strip_intercept_truth.txt"
const FIRST_SET_S: float = 0.25
const SAMPLE_S: float = 0.1
# The interceptor instrument records each staging this many times, in a row.
const REPEATS: int = 2


class Run:
	var family: String = ""
	var lost_at: float = -1.0
	var defenders: Array[Vector3] = []
	var vels: Array[Vector3] = []
	var points: Array[Vector3] = []


func test_export_interception() -> void:
	var path: String = OS.get_environment("MITTS_HORIZON_RUNS")
	if path.is_empty():
		gut.p("set MITTS_HORIZON_RUNS to a saved run file")
		assert_true(true)
		return
	var caps: AISkaterCaps = Duel.match_caps()
	var runs: Array[Run] = _load_saved(path)
	var planned: Array = _load_planned(path + ".planned")
	var has_planned: bool = planned.size() == runs.size()
	gut.p("%d runs, planned paths %s" % [runs.size(),
			"from the dry runs" if has_planned else "as recorded"])
	DirAccess.make_dir_recursive_absolute(ProjectSettings.globalize_path(OUT_DIR))
	var f := FileAccess.open(OUT_DIR + "/runs.csv", FileAccess.WRITE)
	f.store_line("run,family,lost,lost_at,s1,t1,s2,t2,current,f1,g1,f2,g2")
	for ri: int in runs.size():
		var r: Run = runs[ri]
		var pts: Array[Vector3] = planned[ri] if has_planned else r.points
		var times: Array[float] = _times(pts.size())
		var cols := PackedStringArray()
		var firsts := PackedStringArray()
		for i: int in 2:
			if i >= r.defenders.size():
				cols.append_array(["", ""])
				firsts.append_array(["", ""])
				continue
			var best: float = -INF
			var best_t: float = 0.0
			var first: float = -1.0
			var first_set: float = -1.0
			for k: int in pts.size():
				var spare: float = times[k] - _stick_arrival(r.defenders[i], r.vels[i], pts[k], caps)
				if spare > best:
					best = spare
					best_t = times[k]
				if first < 0.0 and spare >= 0.0:
					first = times[k]
				if first_set < 0.0 and spare >= FIRST_SET_S:
					first_set = times[k]
			cols.append_array([str(best), str(best_t)])
			firsts.append_array([str(first), str(first_set)])
		var keep: float = AIStripOdds.path_keep(pts, times, r.defenders, r.vels)
		f.store_line("%d,%s,%d,%.3f,%s,%s,%s,%s,%.6f,%s,%s,%s,%s" % [ri, r.family,
				1 if r.lost_at >= 0.0 else 0, r.lost_at, cols[0], cols[1], cols[2], cols[3],
				-log(maxf(keep, 1e-9)), firsts[0], firsts[1], firsts[2], firsts[3]])
	gut.p("wrote %s/runs.csv" % OUT_DIR)
	if OS.get_environment("MITTS_WRITE_INTERCEPT_TRUTH") == "1" and has_planned:
		_write_truth(runs, planned)
	assert_true(true)


# The strip read's truth file (read by test_strip_odds_vs_truth.gd): one of each
# staging's repeats, each defender's start and the planned puck path, to two
# decimals.
func _write_truth(runs: Array[Run], planned: Array) -> void:
	var f := FileAccess.open(TRUTH_PATH, FileAccess.WRITE)
	f.store_line("# Generated by tests/instruments/ai/test_interception_export.gd with MITTS_WRITE_INTERCEPT_TRUTH=1 from test_interceptor_truth.gd's runs; never hand-edit.")
	f.store_line("# family	lost (1/0)	defenders	per defender: x z vx vz	per %.1f s sample: x z (the planned puck)" % SAMPLE_S)
	var n: int = 0
	for ri: int in range(0, runs.size(), REPEATS):
		var r: Run = runs[ri]
		var line := PackedStringArray([r.family, "1" if r.lost_at >= 0.0 else "0",
				str(r.defenders.size())])
		for i: int in r.defenders.size():
			line.append_array(["%.2f" % r.defenders[i].x, "%.2f" % r.defenders[i].z,
					"%.2f" % r.vels[i].x, "%.2f" % r.vels[i].z])
		for p: Vector3 in planned[ri]:
			line.append_array(["%.2f" % p.x, "%.2f" % p.z])
		f.store_line("\t".join(line))
		n += 1
	gut.p("wrote %d runs to %s" % [n, TRUTH_PATH])


func _times(n: int) -> Array[float]:
	var out: Array[float] = []
	for k: int in n:
		out.append((k + 1) * SAMPLE_S)
	return out


# test_defender_race_truth.gd's _save format; bot carrier runs are left out.
func _load_saved(path: String) -> Array[Run]:
	var out: Array[Run] = []
	var f := FileAccess.open(path, FileAccess.READ)
	while f != null and not f.eof_reached():
		var parts: PackedStringArray = f.get_line().split(" ", false)
		if parts.size() < 5 or parts[0].begins_with("bot"):
			continue
		var run := Run.new()
		run.family = parts[0]
		run.lost_at = float(parts[1])
		var nd: int = int(parts[4])
		var tracked: bool = parts[5] == "T"
		var head: int = 6 if tracked else 5
		for i: int in nd:
			var b: int = head + i * 4
			run.defenders.append(Vector3(float(parts[b]), 0, float(parts[b + 1])))
			run.vels.append(Vector3(float(parts[b + 2]), 0, float(parts[b + 3])))
		var stride: int = 4 + (2 * nd if tracked else 0)
		for k: int in range(head + nd * 4, parts.size(), stride):
			run.points.append(Vector3(float(parts[k + 1]), 0, float(parts[k + 2])))
		out.append(run)
	return out


func _load_planned(path: String) -> Array:
	var out: Array = []
	var f := FileAccess.open(path, FileAccess.READ)
	while f != null and not f.eof_reached():
		var parts: PackedStringArray = f.get_line().split(" ", false)
		if parts.is_empty():
			continue
		var pts: Array[Vector3] = []
		for k: int in range(0, parts.size(), 2):
			pts.append(Vector3(float(parts[k]), 0, float(parts[k + 1])))
		out.append(pts)
	return out


# When his stick can first be within his blade's reach of `point`, on his
# arrival clock from where he is and how he is moving.
func _stick_arrival(pos: Vector3, vel: Vector3, point: Vector3, caps: AISkaterCaps) -> float:
	var to := Vector3(point.x - pos.x, 0.0, point.z - pos.z)
	var d: float = to.length()
	if d <= caps.max_blade_reach:
		return 0.0
	return AIArrival.time_to_arrive_caps(pos, pos + to * ((d - caps.max_blade_reach) / d), vel,
			caps)
