extends RefCounted

# A reviewed table of measured model outputs, checked in beside the tests that
# record it. A test records rows, then `verify` compares them with the file: a
# missing, extra or moved row fails with its pinned and current value. Run the
# test with MITTS_UPDATE_SNAPSHOTS=1 to rewrite the file instead, and review the
# diff in the commit — re-pinning is that one run, not hand edits.
#
# Floats compare within FLOAT_TOLERANCE (they are written to 4 decimals);
# anything else compares as its string.

const UPDATE_ENV := "MITTS_UPDATE_SNAPSHOTS"
const FLOAT_TOLERANCE: float = 5e-4

var _path: String
var _keys: Array[String] = []
var _values: Dictionary = {}


func _init(path: String) -> void:
	_path = path


func record(key: String, value: Variant) -> void:
	assert(not _values.has(key), "snapshot key recorded twice: %s" % key)
	_keys.append(key)
	_values[key] = value


static func updating() -> bool:
	return OS.get_environment(UPDATE_ENV) == "1"


func verify(test: GutTest) -> void:
	if updating():
		_write()
		test.gut.p("snapshot rewritten: %s" % _path)
		test.assert_true(true)
		return
	var pinned: Dictionary = _read()
	test.assert_false(pinned.is_empty(),
			"%s is missing; run with %s=1 to write it" % [_path, UPDATE_ENV])
	for key: String in _keys:
		var now: String = _format(_values[key])
		if not pinned.has(key):
			test.fail_test("%s: new row '%s' = %s (rewrite the snapshot)" % [_path, key, now])
			continue
		var was: String = pinned[key]
		test.assert_true(_same(was, now), "%s: '%s' pinned %s, now %s" % [_path, key, was, now])
	for key: String in pinned:
		if not _values.has(key):
			test.fail_test("%s: row '%s' is no longer recorded (rewrite the snapshot)" % [_path, key])


static func _format(value: Variant) -> String:
	if value is float:
		return "%.4f" % value
	return str(value)


static func _same(was: String, now: String) -> bool:
	if was.is_valid_float() and now.is_valid_float() and "." in was:
		return absf(was.to_float() - now.to_float()) <= FLOAT_TOLERANCE
	return was == now


func _read() -> Dictionary:
	var out: Dictionary = {}
	var f: FileAccess = FileAccess.open(_path, FileAccess.READ)
	if f == null:
		return out
	while not f.eof_reached():
		var line: String = f.get_line()
		if line.is_empty() or line.begins_with("#"):
			continue
		var cols: PackedStringArray = line.split("\t")
		if cols.size() == 2:
			out[cols[0]] = cols[1]
	return out


func _write() -> void:
	var f: FileAccess = FileAccess.open(_path, FileAccess.WRITE)
	assert(f != null, "cannot write %s" % _path)
	f.store_line("# Generated by %s=1; review the diff, never hand-edit." % UPDATE_ENV)
	for key: String in _keys:
		f.store_line("%s\t%s" % [key, _format(_values[key])])
